<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.DoctorsAppointment" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSecondaryVariant">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/brand_primary</item>
        
        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@color/bg_main</item>
        
        <!-- Card Style -->
        <item name="materialCardViewStyle">@style/Widget.MedCare.Card</item>
    </style>

    <style name="AppTheme_NoActionBar" parent="Theme.DoctorsAppointment" />

    <style name="DATILT" parent="Widget.Design.TextInputLayout">
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="colorAccent">@color/brand_primary</item>
    </style>
</resources>